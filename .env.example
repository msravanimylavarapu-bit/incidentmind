# Hindsight memory server (self-hosted default)
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentmind

# Chat model used by IncidentMind: openai or anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Hindsight server's own model credentials (used to index/reflect memories)
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# Optional keyless local provider: start Ollama on the host, pull qwen2.5:3b,
# then set provider=ollama, model=qwen2.5:3b, base URL=http://host.docker.internal:11434/v1.
HINDSIGHT_API_LLM_BASE_URL=
